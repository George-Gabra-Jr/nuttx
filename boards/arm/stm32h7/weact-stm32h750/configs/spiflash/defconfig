#
# WeAct STM32H750 configuration with external memory support
# Includes: 8MB SPI Flash, 8MB QSPI Flash
#
# CONFIG_NSH_DISABLE_IFCONFIG is not set
# CONFIG_NSH_DISABLE_PS is not set
# CONFIG_STANDARD_SERIAL is not set
# CONFIG_STM32H7_USE_LEGACY_PINMAP is not set
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD="weact-stm32h750"
CONFIG_ARCH_BOARD_WEACT_STM32H750=y
CONFIG_ARCH_CHIP="stm32h7"
CONFIG_ARCH_CHIP_STM32H750IB=y
CONFIG_ARCH_CHIP_STM32H7=y
CONFIG_ARCH_CHIP_STM32H7_CORTEXM7=y
CONFIG_ARMV7M_DCACHE=y
CONFIG_ARMV7M_ICACHE=y
CONFIG_BOARD_LOOPSPERMSEC=43103
CONFIG_BUILTIN=y
# CONFIG_DEBUG_SYMBOLS is not set

# Scheduler Configuration
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKPRIORITY=224
CONFIG_SCHED_HPWORKSTACKSIZE=2048

CONFIG_EXPERIMENTAL=y
# CONFIG_HAVE_CXX is not set
# CONFIG_HAVE_CXXINITIALIZE is not set
CONFIG_INIT_ENTRYPOINT="nsh_main"
# CONFIG_INTELHEX_BINARY is not set

# MTD
CONFIG_MTD=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_MTD_W25=y
CONFIG_MTD_W25QXXXJV=y
CONFIG_MTD_SMART=y

# Memory configuration
CONFIG_MM_REGIONS=2
CONFIG_MQ_MAXMSGSIZE=64

# NSH Configuration
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
# CONFIG_NSH_READLINE is not set

# System configuration
CONFIG_PREALLOC_TIMERS=2
CONFIG_RAM_SIZE=524288
CONFIG_RAM_START=0x24000000
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y

# SPI Configuration
CONFIG_SPI=y
CONFIG_SPI_CMDDATA=y
CONFIG_STM32H7_SPI1=y

# Date and time
CONFIG_START_DAY=1
CONFIG_START_MONTH=1
CONFIG_START_YEAR=2025

# Serial console
CONFIG_STM32H7_USART1=y
CONFIG_USART1_SERIAL_CONSOLE=y

# System components
CONFIG_SYSTEM_NSH=y
CONFIG_TASK_NAME_SIZE=0
